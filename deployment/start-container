#!/usr/bin/env sh
#
# Container entrypoint.
#
# Caches are built here (and not in the Dockerfile) on purpose: config:cache
# bakes the *runtime* environment into the cache, so baking it at build time
# would ignore env vars injected by the orchestrator.

set -eu

container_mode=${CONTAINER_MODE:-"http"}
running_migrations_and_seeders=${RUNNING_MIGRATIONS_AND_SEEDERS:-"false"}

initialStuff() {
    echo "Container mode: ${container_mode}"

    if [ "${running_migrations_and_seeders}" = "true" ]; then
        echo "Running migrations and seeding database ..."
        # --isolated needs a shared cache lock; fall back when the cache store
        # does not support it.
        php artisan migrate --isolated --seed --force || php artisan migrate --seed --force
    fi

    php artisan storage:link

    # Clear first: `route:cache` (inside `optimize`) fails with a
    # CompiledRouteCollection type error when a route cache is already present.
    # A container restart keeps bootstrap/cache, so optimizing twice in a row
    # used to crash the container and, with restart=always, crash-loop it.
    # Clearing also guarantees caches are rebuilt from the runtime env.
    php artisan optimize:clear

    # Rebuild config + events + routes + views + Filament caches in one go.
    php artisan optimize
}

if [ "$#" -gt 0 ]; then
    exec "$@"
fi

case "${container_mode}" in
    http)
        initialStuff

        echo "Octane server: ${OCTANE_SERVER:-frankenphp}"

        case "${OCTANE_SERVER:-frankenphp}" in
            frankenphp)
                exec /usr/bin/supervisord -c /etc/supervisor/conf.d/supervisord.frankenphp.conf
                ;;
            swoole)
                exec /usr/bin/supervisord -c /etc/supervisor/conf.d/supervisord.swoole.conf
                ;;
            roadrunner)
                exec /usr/bin/supervisord -c /etc/supervisor/conf.d/supervisord.roadrunner.conf
                ;;
            *)
                echo "Invalid Octane server supplied: ${OCTANE_SERVER}"
                exit 1
                ;;
        esac
        ;;
    horizon)
        initialStuff
        exec /usr/bin/supervisord -c /etc/supervisor/conf.d/supervisord.horizon.conf
        ;;
    reverb)
        initialStuff
        exec /usr/bin/supervisord -c /etc/supervisor/conf.d/supervisord.reverb.conf
        ;;
    scheduler)
        initialStuff
        exec /usr/bin/supervisord -c /etc/supervisor/conf.d/supervisord.scheduler.conf
        ;;
    worker)
        if [ -z "${WORKER_COMMAND:-}" ]; then
            echo "WORKER_COMMAND is undefined."
            exit 1
        fi

        initialStuff
        exec /usr/bin/supervisord -c /etc/supervisor/conf.d/supervisord.worker.conf
        ;;
    *)
        echo "Container mode mismatched: ${container_mode}"
        exit 1
        ;;
esac
